{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true,
		"skipLibCheck": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"rootDir": "src",
		"types": [
			"node"
		],
		"lib": [
			"es2023",
			"esnext.array"
		]
	},
	"include": [
		"src",
		"worker-configuration.d.ts"
	]
}
