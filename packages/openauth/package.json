{
	"name": "@kjanat/openauth",
	"version": "0.5.0",
	"description": "Standards-based OAuth 2.0 issuer and client for Hono, Bun, Node.js, AWS Lambda and Cloudflare Workers",
	"keywords": [
		"oauth",
		"oauth2",
		"openid",
		"auth",
		"issuer",
		"pkce",
		"hono",
		"cloudflare-workers"
	],
	"homepage": "https://github.com/kjanat/openauthjs#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/openauthjs.git",
		"directory": "packages/openauth"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./*": {
			"import": "./dist/esm/*.js",
			"types": "./dist/types/*.d.ts"
		},
		"./ui": {
			"import": "./dist/esm/ui/index.js",
			"types": "./dist/types/ui/index.d.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "bun run script/build.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@standard-schema/spec": "1.0.0-beta.3",
		"aws4fetch": "1.0.20",
		"jose": "5.9.6"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20241205.0",
		"@tsconfig/node22": "catalog:",
		"@types/node": "catalog:",
		"arctic": "2.2.2",
		"hono": "4.6.9",
		"typescript": "catalog:",
		"valibot": "catalog:"
	},
	"peerDependencies": {
		"arctic": "^2.2.2",
		"hono": "^4.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
