{
	"name": "@kjanat/openauth",
	"version": "0.6.0",
	"description": "Standards-based OAuth 2.0 issuer and client for Hono, Bun, Node.js, AWS Lambda and Cloudflare Workers",
	"keywords": [
		"oauth",
		"oauth2",
		"openid",
		"auth",
		"issuer",
		"pkce",
		"hono",
		"cloudflare-workers"
	],
	"homepage": "https://github.com/kjanat/openauthjs#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/openauthjs.git",
		"directory": "packages/openauth"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./*": {
			"import": "./dist/esm/*.js",
			"types": "./dist/types/*.d.ts"
		},
		"./ui": {
			"import": "./dist/esm/ui/index.js",
			"types": "./dist/types/ui/index.d.ts"
		}
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "bun run script/build.ts",
		"test": "bun test",
		"typecheck": "bun run --silent typegen && tsrs --noEmit",
		"typegen": "wrangler types -c wrangler.jsonc --include-env=false >/dev/null"
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0",
		"aws4fetch": "1.0.20",
		"jose": "6.2.15"
	},
	"devDependencies": {
		"@tsconfig/node22": "catalog:",
		"@types/node": "catalog:",
		"arctic": "2.2.2",
		"hono": "4.13.16",
		"tsrs": "0.20.1-ts7.1.0-beta",
		"typescript": "catalog:",
		"valibot": "catalog:",
		"wrangler": "catalog:"
	},
	"peerDependencies": {
		"arctic": "^2.2.2",
		"hono": "^4.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
